diff --git a/plugin/src/Caelestia/I18n/CMakeLists.txt b/plugin/src/Caelestia/I18n/CMakeLists.txt
index d45bf02f..50fe49ec 100644
--- a/plugin/src/Caelestia/I18n/CMakeLists.txt
+++ b/plugin/src/Caelestia/I18n/CMakeLists.txt
@@ -1,7 +1,18 @@
 set(po_files
-    # All .po files should go here
+    trs/zh_CN.po
 )
 
+# Qt catalogs for qsTr(). This is a separate mechanism from the custom
+# Translator: the .po/.mo pair above feeds Tr.tr(), while qsTr() is served by a
+# QTranslator that Translator installs from the matching .qm.
+set(ts_files
+    trs/zh_CN.ts
+)
+
+# Qt6::lrelease is only defined once LinguistTools has been requested. A plain
+# find_package(Qt6 COMPONENTS ...) elsewhere does not pull it in.
+find_package(Qt6 REQUIRED COMPONENTS LinguistTools)
+
 set(trs_script "${CMAKE_SOURCE_DIR}/scripts/trs.fish")
 
 # Compile .po -> .mo and alias each one to <lang>.mo in the module's resources
@@ -24,6 +35,23 @@ foreach(po IN LISTS po_files)
     list(APPEND mo_files "${mo}")
 endforeach()
 
+set(qm_files)
+foreach(ts IN LISTS ts_files)
+    cmake_path(GET ts STEM lang)
+    set(qm "${CMAKE_CURRENT_BINARY_DIR}/trs/${lang}.qm")
+
+    add_custom_command(
+        OUTPUT "${qm}"
+        COMMAND Qt6::lrelease -silent "${CMAKE_CURRENT_SOURCE_DIR}/${ts}" -qm "${qm}"
+        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${ts}"
+        COMMENT "Compiling Qt translations for ${lang}"
+        VERBATIM
+    )
+
+    set_source_files_properties("${qm}" PROPERTIES QT_RESOURCE_ALIAS "${lang}.qm")
+    list(APPEND qm_files "${qm}")
+endforeach()
+
 if(CAELESTIA_TEST_TRS)
     set(test_mo "${CMAKE_CURRENT_BINARY_DIR}/trs/test.mo")
 
@@ -50,6 +78,7 @@ qml_module(caelestia-i18n
         Units.qml
     RESOURCES
         ${mo_files}
+        ${qm_files}
     LIBRARIES
         caelestia-util
         caelestia-config
