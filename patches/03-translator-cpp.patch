 bool Translator::trsChangedFlag() {
@@ -203,7 +209,28 @@ void Translator::loadTranslations() {
     if (!m_plurals.parse(lookupRaw("")))
         qCDebug(lcI18n) << "No usable Plural-Forms for" << m_language << "- assuming the default rule";
 
-    qCDebug(lcI18n) << "Loaded" << m_count << "messages for" << m_language;
+    qCInfo(lcI18n) << "Loaded" << m_count << "messages for" << m_language;
+}
+
+// qsTr() in QML is resolved by the engine through any QTranslator installed on
+// the application, which the hand-rolled .mo reader above does not feed. The
+// catalog is compiled from the same sources by lrelease into <lang>.qm.
+void Translator::loadQtTranslations() {
+    QCoreApplication::removeTranslator(&m_qtTranslator);
+
+    if (m_language.isEmpty())
+        return;
+
+    const auto path = resourceDir() + m_language + u".qm"_s;
+    if (!m_qtTranslator.load(path)) {
+        qCDebug(lcI18n) << "No Qt catalog for" << m_language;
+        return;
+    }
+
+    if (!QCoreApplication::installTranslator(&m_qtTranslator))
+        qCWarning(lcI18n) << "Failed to install the Qt catalog for" << m_language;
+    else
+        qCInfo(lcI18n) << "Installed the Qt catalog for" << m_language;
 }
 
